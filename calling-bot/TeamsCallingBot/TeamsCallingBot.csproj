<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TeamsCallingBot</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Communications SDK: Microsoft.Graph + Microsoft.Kiota.* + Microsoft.Graph.Core are NOT optional.
      They are declared in Microsoft.Graph.Communications.Core 1.2.0.10563 nuspec (e.g. Microsoft.Graph 5.38.0,
      specific Kiota 1.3.3/1.7.2, etc.) and are restored transitively. You cannot remove them while using
      this SDK without removing the SDK. Do not add extra top-level Microsoft.Graph or Microsoft.Kiota
      versions — that reintroduced MissingMethodException. -->

    <PackageReference Include="Microsoft.Graph.Communications.Calls" Version="1.2.0.10563" />
    <PackageReference Include="Microsoft.Graph.Communications.Calls.Media" Version="1.2.0.10563" />
    <PackageReference Include="Microsoft.Skype.Bots.Media" Version="1.27.0.2-alpha" />

    <!-- Existed before this task; required for the project to build (auth) — not a substitute for Graph. -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.66.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.2.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
  </ItemGroup>
</Project>
